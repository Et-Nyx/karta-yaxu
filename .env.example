# Karta Yaxu — Environment Variables
# Copy this file to .env and adjust values as needed.

# SQLite database path
DATABASE_URL=sqlite:./data/rom.db

# Path to TOML seed templates
SEED_DATA_PATH=data/template

# Log level (trace, debug, info, warn, error)
RUST_LOG=debug

# Server port
PORT=3000

# Set to "true" in production (requires HTTPS)
SECURE_COOKIE=false
