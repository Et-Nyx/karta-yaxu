# Karta Yaxu 2.0 — Environment Variables
# Copy this file to .env and adjust values as needed.

# SQLite database path (relative to working directory)
DATABASE_URL=./data/rom.db

# Server port
PORT=3000

# Server host (0.0.0.0 for Docker)
HOST=0.0.0.0

# Node environment (production | development)
NODE_ENV=production
